# ---------------------------------------------------------------------------
# CLAUDIUS & CO. — environment
# Copy to .env.local for development, and set the same keys on your host.
# ---------------------------------------------------------------------------

# Public site URL — drives canonical URLs, the sitemap and social preview cards.
# Leave it unset on Vercel and the project's production domain is used, which
# already prefers your custom domain over the .vercel.app one. Set it explicitly
# when you want to be certain, and locally so links resolve to your dev server.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Postgres connection string. Leave unset to run the site on the built-in
# seed content (the CMS is unavailable without it).
#
# Neon gives you two forms of this string. Which one you want depends on where
# it is being used:
#
#   Local / .env.local  -> the DIRECT string (no "-pooler" in the host).
#                          `prisma db push` and `prisma migrate` cannot run
#                          through a connection pooler and will fail on the
#                          pooled string.
#
#   Vercel / production -> the POOLED string (host contains "-pooler").
#                          Serverless functions open and close connections
#                          constantly; the pooler is what stops you exhausting
#                          the connection limit.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signing key for CMS sessions. Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# Vercel Blob store, for image and video uploads in the CMS.
BLOB_READ_WRITE_TOKEN=""

# Used once by `npm run db:seed` to create the first editor account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
