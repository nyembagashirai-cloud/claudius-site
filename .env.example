# ---------------------------------------------------------------------------
# CLAUDIUS & CO. — environment
# Copy to .env.local for development, and set the same keys on your host.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL="https://claudiusandco.com"

# Postgres connection string. Leave unset to run the site on the built-in
# seed content (the CMS is unavailable without it).
DATABASE_URL="postgresql://user:password@host:5432/claudius?sslmode=require"

# Signing key for CMS sessions. Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# Vercel Blob store, for image and video uploads in the CMS.
BLOB_READ_WRITE_TOKEN=""

# Used once by `npm run db:seed` to create the first editor account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
